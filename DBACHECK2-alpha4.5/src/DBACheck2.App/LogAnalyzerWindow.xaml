<Window x:Class="DBACheck2.App.LogAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - Transaction Log Analyzer" Height="760" Width="1320" MinHeight="650" MinWidth="1100" WindowStartupLocation="CenterOwner" Background="#0B1220">
<Window.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="INCIDENT ANALYZER · TRANSACTION LOG" Foreground="#38E8D0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Alpha 4.2 · Uso · Reuse Wait · Files · Backups · Transacciones · Solo lectura" Foreground="#B7C3D7"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
<Button x:Name="RefreshButton" Content="ACTUALIZAR" Padding="18,8" Click="RefreshButton_Click"/>
<Button x:Name="DiagnosisButton" Content="DIAGNÓSTICO" Margin="10,0,0,0" Padding="18,8" IsEnabled="False" Click="DiagnosisButton_Click"/>
<Button x:Name="FilesButton" Content="VER FILES" Margin="10,0,0,0" Padding="18,8" IsEnabled="False" Click="FilesButton_Click"/>
<Button x:Name="TransactionsButton" Content="VER TRANSACCIONES" Margin="10,0,0,0" Padding="18,8" IsEnabled="False" Click="TransactionsButton_Click"/>
<Button x:Name="BackupsButton" Content="VER BACKUPS" Margin="10,0,0,0" Padding="18,8" IsEnabled="False" Click="BackupsButton_Click"/>
<Button x:Name="EvidenceButton" Content="CAPTURAR EVIDENCIA" Margin="10,0,0,0" Padding="18,8" IsEnabled="False" Click="EvidenceButton_Click"/>
<TextBlock x:Name="AnalyzerStatus" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="White"/>
</StackPanel>
<TextBlock Grid.Row="2" x:Name="SummaryText" Margin="2,0,0,10" Foreground="#D5DEEB" FontWeight="SemiBold" Text="Consultando logs..."/>
<DataGrid x:Name="LogGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" SelectionChanged="LogGrid_SelectionChanged">
<DataGrid.Columns>
<DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
<DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="180"/>
<DataGridTextColumn Header="Log MB" Binding="{Binding LogSizeMb}" Width="110"/>
<DataGridTextColumn Header="Used MB" Binding="{Binding UsedMb}" Width="110"/>
<DataGridTextColumn Header="Used %" Binding="{Binding UsedPct}" Width="90"/>
<DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryModel}" Width="110"/>
<DataGridTextColumn Header="Reuse Wait" Binding="{Binding ReuseWait}" Width="180"/>
<DataGridTextColumn Header="Last LOG Backup" Binding="{Binding LastLogBackup}" Width="180"/>
</DataGrid.Columns></DataGrid>
<TextBlock Grid.Row="4" Margin="0,12,0,6" Foreground="#38E8D0" FontWeight="Bold" Text="EVIDENCIA / DIAGNÓSTICO DE LA BASE SELECCIONADA"/>
<TextBox Grid.Row="5" x:Name="DetailText" Background="#111C2F" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Selecciona una base para investigar su Transaction Log."/>
</Grid></Window>