<Window x:Class="DBACheck2.App.BackupJobsAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - Backup &amp; Jobs Analyzer" Height="760" Width="1320" MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterOwner" Background="#0B1220">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="INCIDENT ANALYZER · BACKUPS &amp; SQL AGENT JOBS" Foreground="#38E8D0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Alpha 4.3 · Backup history · Job failures · Evidence · Read-only" Foreground="#B7C3D7"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><Button x:Name="RefreshButton" Content="ACTUALIZAR" Padding="18,8" Click="RefreshButton_Click"/><Button x:Name="DiagnosisButton" Content="DIAGNÓSTICO" Padding="18,8" Margin="10,0,0,0" IsEnabled="False" Click="DiagnosisButton_Click"/><Button x:Name="HistoryButton" Content="VER HISTORIAL" Padding="18,8" Margin="10,0,0,0" IsEnabled="False" Click="HistoryButton_Click"/><Button x:Name="EvidenceButton" Content="CAPTURAR EVIDENCIA" Padding="18,8" Margin="10,0,0,0" IsEnabled="False" Click="EvidenceButton_Click"/><TextBlock x:Name="AnalyzerStatus" Foreground="White" VerticalAlignment="Center" Margin="18,0"/></StackPanel>
<TabControl Grid.Row="2" x:Name="ModeTabs" SelectionChanged="ModeTabs_SelectionChanged"><TabItem Header="BACKUPS"><DataGrid x:Name="BackupGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="BackupGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="180"/><DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryModel}" Width="100"/><DataGridTextColumn Header="Last FULL" Binding="{Binding LastFull}" Width="180"/><DataGridTextColumn Header="Last DIFF" Binding="{Binding LastDiff}" Width="180"/><DataGridTextColumn Header="Last LOG" Binding="{Binding LastLog}" Width="180"/><DataGridTextColumn Header="FULL MB" Binding="{Binding LastFullMb}" Width="100"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="SQL AGENT JOBS"><DataGrid x:Name="JobGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="JobGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="*"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/><DataGridTextColumn Header="Last outcome" Binding="{Binding Outcome}" Width="120"/><DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="180"/><DataGridTextColumn Header="Duration sec" Binding="{Binding LastDurationSeconds}" Width="100"/><DataGridTextColumn Header="Message" Binding="{Binding LastMessage}" Width="350"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
<TextBlock Grid.Row="3" Text="EVIDENCIA / DIAGNÓSTICO" Foreground="#38E8D0" FontWeight="Bold" Margin="0,10,0,6"/><TextBox Grid.Row="4" x:Name="DetailText" Background="#111C2F" Foreground="White" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="Selecciona una base o job para investigar."/>
</Grid></Window>
