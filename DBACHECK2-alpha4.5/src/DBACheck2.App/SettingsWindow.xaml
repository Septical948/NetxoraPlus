<Window x:Class="DBACheck2.App.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - Settings" Background="#0A0D18">
<Grid Margin="18">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16">
  <TextBlock x:Name="TitleText" Text="SETTINGS" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
  <TextBlock x:Name="SubtitleText" Text="Application preferences" Foreground="#B7C3D7"/>
 </StackPanel>
 <Border Grid.Row="1" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8" Padding="16">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="LanguageTitleText" Text="LANGUAGE" Foreground="#8F9BB3" FontWeight="Bold"/>
    <TextBlock x:Name="LanguageHelpText" Text="Changes apply immediately and are remembered." Foreground="#718096" TextWrapping="Wrap" Margin="0,4,15,0"/>
   </StackPanel>
   <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="34" SelectionChanged="LanguageBox_SelectionChanged">
    <ComboBoxItem Content="Español" Tag="es"/>
    <ComboBoxItem Content="English" Tag="en"/>
   </ComboBox>
   <TextBlock Grid.Column="2" x:Name="StatusText" Foreground="#38E8D0" Margin="16,7,0,0"/>
  </Grid>
 </Border>
 <Grid Grid.Row="2" Margin="0,14,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#101526" BorderBrush="#20263A" BorderThickness="1" CornerRadius="8" Padding="16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="SubscriptionTitleText" Text="SUBSCRIPTION" Foreground="#8F9BB3" FontWeight="Bold"/>
     <TextBlock x:Name="SubscriptionText" Text="Plans, license status and billing." Foreground="#B7C3D7" Margin="0,6,14,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="SubscriptionButton" Content="MANAGE SUBSCRIPTION" Padding="14,8" VerticalAlignment="Center" Click="SubscriptionButton_Click"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#101526" BorderBrush="#20263A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock x:Name="FutureTitleText" Text="PREFERENCES" Foreground="#8F9BB3" FontWeight="Bold"/>
    <TextBlock x:Name="FutureText" Text="This area is prepared for future UI, startup and update-channel preferences." Foreground="#B7C3D7" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </Grid>
</Grid>
</Window>