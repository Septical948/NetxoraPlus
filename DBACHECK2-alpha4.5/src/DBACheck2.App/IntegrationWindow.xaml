<Window x:Class="DBACheck2.App.IntegrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - Monitoring Integrations" Background="#0A0D18">
<Grid Margin="12">
 <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  <RowDefinition x:Name="ListRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="125"/>
 </Grid.RowDefinitions>

 <StackPanel Margin="0,0,0,12">
  <TextBlock x:Name="TitleText" Text="MONITORING INTEGRATIONS" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
  <TextBlock x:Name="SubtitleText" Text="Beta 2 · External monitoring → DB evidence → correlation · Read-only" Foreground="#B7C3D7"/>
 </StackPanel>

 <Border Grid.Row="1" Background="#101526" BorderBrush="#2B3150" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="SavedLabel" Text="SAVED INTEGRATION" Foreground="#91A0B8" FontSize="10" FontWeight="Bold"/><ComboBox x:Name="ProfilesBox" MinWidth="500" DisplayMemberPath="Display" SelectionChanged="ProfilesBox_SelectionChanged"/></StackPanel>
    <Button Grid.Column="1" x:Name="DeleteButton" Content="DELETE" MinWidth="100" Margin="10,14,0,0" Click="Delete_Click"/>
   </Grid>

   <Grid Grid.Row="1" Margin="0,12,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0"><TextBlock x:Name="ProfileLabel" Text="PROFILE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold"/><TextBox x:Name="ProfileNameBox" Text="ZABBIX-PROD"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock x:Name="SourceLabel" Text="SOURCE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold"/><ComboBox x:Name="SourceBox"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock x:Name="EndpointLabel" Text="API URL" Foreground="#91A0B8" FontSize="10" FontWeight="Bold"/><TextBox x:Name="EndpointBox" ToolTip="Example: https://zabbix.example/zabbix or full api_jsonrpc.php URL"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock x:Name="TokenLabel" Text="API TOKEN" Foreground="#91A0B8" FontSize="10" FontWeight="Bold"/><PasswordBox x:Name="TokenBox"/></StackPanel>
    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
     <CheckBox x:Name="RememberTokenBox" Content="Remember token" Foreground="#AAB5C8" Margin="0,0,0,4"/>
     <CheckBox x:Name="VerifyTlsBox" Content="Verify TLS certificate" Foreground="#AAB5C8" IsChecked="True"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>

 <Grid Grid.Row="2" Margin="0,0,0,10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button x:Name="SaveButton" Content="SAVE" MinWidth="100" Padding="15,7" Click="Save_Click"/>
  <Button Grid.Column="1" x:Name="TestButton" Content="TEST API" MinWidth="110" Padding="15,7" Margin="8,0,0,0" Click="Test_Click"/>
  <Button Grid.Column="2" x:Name="LoadProblemsButton" Content="LOAD OPEN PROBLEMS" MinWidth="160" Padding="15,7" Margin="8,0,0,0" Click="LoadProblems_Click"/>
  <Button Grid.Column="3" x:Name="DiagnoseButton" Content="DIAGNOSE SELECTED" MinWidth="155" Padding="15,7" Margin="8,0,0,0" IsEnabled="False" Click="Diagnose_Click"/>
  <Button Grid.Column="4" x:Name="CreateIncidentButton" Content="CREATE INCIDENT" MinWidth="135" Padding="15,7" Margin="8,0,0,0" IsEnabled="False" Click="CreateIncident_Click"/>
  <TextBlock Grid.Column="5" x:Name="StatusText" Foreground="#D5DEEB" Margin="14,7,0,0" TextWrapping="Wrap"/>
 </Grid>

 <DataGrid x:Name="EventsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
  Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A"
  SelectionChanged="EventsGrid_SelectionChanged">
  <DataGrid.Columns>
   <DataGridTextColumn x:Name="SeverityColumn" Header="Severity" Binding="{Binding Severity}" Width="90"/>
   <DataGridTextColumn x:Name="NativeSeverityColumn" Header="Native" Binding="{Binding NativeSeverity}" Width="100"/>
   <DataGridTextColumn x:Name="HostColumn" Header="Host" Binding="{Binding Host}" Width="180"/>
   <DataGridTextColumn x:Name="ProblemColumn" Header="Problem" Binding="{Binding Name}" Width="*"/>
   <DataGridTextColumn x:Name="TimeColumn" Header="Time" Binding="{Binding Timestamp}" Width="155"/>
   <DataGridCheckBoxColumn x:Name="AckColumn" Header="Ack" Binding="{Binding Acknowledged}" Width="55"/>
  </DataGrid.Columns>
 </DataGrid>

 <Grid Grid.Row="4" Margin="0,10,0,6">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBlock x:Name="DetailTitleText" Text="CORRELATION / EVIDENCE" Foreground="#38E8D0" FontWeight="Bold"/>
  <Button Grid.Column="1" x:Name="ExpandDetailButton" Content="EXPAND" Padding="12,4" Click="ExpandDetailButton_Click"/>
 </Grid>

 <TextBox x:Name="DetailText" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111C2F" Foreground="#E8EDF7"
  BorderThickness="0" Padding="12" FontFamily="Consolas" Text="Select a monitoring problem to inspect its DBACHECK correlation hint."/>
</Grid>
</Window>