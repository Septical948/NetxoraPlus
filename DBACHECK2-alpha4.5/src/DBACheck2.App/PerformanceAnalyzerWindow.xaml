<Window x:Class="DBACheck2.App.PerformanceAnalyzerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - Performance Incident Analyzer" Height="780" Width="1380" MinHeight="650" MinWidth="1100"
 WindowStartupLocation="CenterOwner" Background="#0B1220">
<Window.Resources>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,3"/></Style>
</Window.Resources>
<Grid Margin="12">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="170"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="TitleText" Text="INCIDENT ANALYZER · PERFORMANCE" Foreground="#38E8D0" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="Beta 1 · Active Requests · CPU · I/O · Waits · Blocking · Memory Grants · Evidence · Read-only" Foreground="#B7C3D7"/></StackPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
  <Button x:Name="RefreshButton" Padding="16,8" Content="ACTUALIZAR" Click="RefreshButton_Click"/>
  <Button x:Name="DiagnosticButton" Margin="8,0,0,0" Padding="16,8" Content="DIAGNÓSTICO" Click="DiagnosticButton_Click" IsEnabled="False"/>
  <Button x:Name="SqlButton" Margin="8,0,0,0" Padding="16,8" Content="VER SQL" Click="SqlButton_Click" IsEnabled="False"/>
  <Button x:Name="RequestButton" Margin="8,0,0,0" Padding="16,8" Content="VER REQUEST" Click="RequestButton_Click" IsEnabled="False"/>
  <Button x:Name="WaitsButton" Margin="8,0,0,0" Padding="16,8" Content="VER WAITS" Click="WaitsButton_Click"/>
  <Button x:Name="MemoryButton" Margin="8,0,0,0" Padding="16,8" Content="MEMORY GRANTS" Click="MemoryButton_Click"/>
  <Button x:Name="EvidenceButton" Margin="8,0,0,0" Padding="16,8" Content="CAPTURAR EVIDENCIA" Click="EvidenceButton_Click" IsEnabled="False"/>
  <TextBlock x:Name="AnalyzerStatus" Margin="16,0,0,0" Foreground="White" VerticalAlignment="Center" Text="Listo."/>
 </StackPanel>
 <TextBlock Grid.Row="2" x:Name="SummaryText" Margin="2,0,0,8" Foreground="#D5DEEB" FontWeight="SemiBold"/>
 <DataGrid x:Name="RequestGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="RequestGrid_SelectionChanged"
  Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
  <DataGrid.Columns>
   <DataGridTextColumn x:Name="StatusColumn" Header="Estado" Binding="{Binding Status}" Width="80"/>
   <DataGridTextColumn Header="SPID" Binding="{Binding SessionId}" Width="60"/>
   <DataGridTextColumn Header="Sec" Binding="{Binding ElapsedSeconds}" Width="65"/>
   <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="120"/>
   <DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="120"/>
   <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="125"/>
   <DataGridTextColumn Header="CPU ms" Binding="{Binding CpuMs}" Width="80"/>
   <DataGridTextColumn Header="Reads" Binding="{Binding Reads}" Width="80"/>
   <DataGridTextColumn Header="Logical" Binding="{Binding LogicalReads}" Width="85"/>
   <DataGridTextColumn Header="Writes" Binding="{Binding Writes}" Width="75"/>
   <DataGridTextColumn Header="Wait" Binding="{Binding WaitType}" Width="130"/>
   <DataGridTextColumn Header="Wait ms" Binding="{Binding WaitMs}" Width="75"/>
   <DataGridTextColumn Header="Blocked by" Binding="{Binding BlockingSessionId}" Width="80"/>
   <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="120"/>
  </DataGrid.Columns>
 </DataGrid>
 <Grid Grid.Row="4" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="#38E8D0" FontWeight="Bold" Text="EVIDENCIA / DIAGNÓSTICO PERFORMANCE"/><Button x:Name="ExpandDetailButton" Grid.Column="1" Content="EXPANDIR" Padding="12,4" Click="ExpandDetailButton_Click"/></Grid>
 <TextBox Grid.Row="5" x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111C2F" Foreground="White" BorderThickness="0" Padding="12" FontFamily="Consolas" Text="Selecciona un request para investigar."/>
</Grid>
</Window>