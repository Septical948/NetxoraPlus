<Window x:Class="DBACheck2.App.SubscriptionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - Subscription" Background="#0A0D18">
<Grid Margin="18">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

 <StackPanel Margin="0,0,0,14">
  <TextBlock x:Name="TitleText" Text="SUBSCRIPTION" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
  <TextBlock x:Name="SubtitleText" Text="Plans, license status and billing" Foreground="#B7C3D7"/>
 </StackPanel>

 <Border Grid.Row="1" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="CurrentPlanLabel" Text="CURRENT PLAN" Foreground="#8F9BB3" FontWeight="Bold" FontSize="10"/>
    <TextBlock x:Name="CurrentPlanText" Text="Loading..." Foreground="#38E8D0" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
    <TextBlock x:Name="CurrentStatusText" Foreground="#B7C3D7" Margin="0,3,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" x:Name="RefreshButton" Content="REFRESH STATUS" Margin="8,0,0,0" Padding="14,8" VerticalAlignment="Center" Click="RefreshButton_Click"/>
   <Button Grid.Column="2" x:Name="PortalButton" Content="CUSTOMER PORTAL" Margin="8,0,0,0" Padding="14,8" VerticalAlignment="Center" Click="PortalButton_Click"/>
  </Grid>
 </Border>

 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Grid.Column="0" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="10" Padding="16">
    <StackPanel>
     <TextBlock Text="STANDARD" Foreground="#D9E1EE" FontSize="20" FontWeight="Bold"/>
     <TextBlock x:Name="StandardPriceText" Text="$29 / month" Foreground="#38E8D0" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
     <TextBlock Text="$290 / year" Foreground="#8F9BB3" Margin="0,0,0,10"/>
     <TextBlock x:Name="StandardPositionText" Text="Individual DBA toolkit." Foreground="#B7C3D7" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="✓ Multi-engine profiles" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Quick Check" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Diagnostics modules" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Full Assessment" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Assessment export" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Incident History" Foreground="#E8EDF7" Margin="0,3"/>
     <Button x:Name="StandardMonthlyButton" Content="STANDARD MONTHLY" Margin="0,16,0,6" Padding="12,8" Click="StandardMonthlyButton_Click"/>
     <Button x:Name="StandardAnnualButton" Content="STANDARD ANNUAL" Padding="12,8" Click="StandardAnnualButton_Click"/>
    </StackPanel>
   </Border>

   <Border Grid.Column="2" Background="#12172B" BorderBrush="#7657FF" BorderThickness="2" CornerRadius="10" Padding="16">
    <StackPanel>
     <TextBlock Text="PLUS" Foreground="#BDA7FF" FontSize="20" FontWeight="Bold"/>
     <TextBlock x:Name="PlusPriceText" Text="$69 / month" Foreground="#38E8D0" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
     <TextBlock Text="$690 / year" Foreground="#8F9BB3" Margin="0,0,0,10"/>
     <TextBlock x:Name="PlusPositionText" Text="DBA operations platform." Foreground="#B7C3D7" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="✓ Everything in Standard" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Monitoring integrations" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Alert Inbox P1-P4" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Cross-monitor correlation" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Targeted diagnosis from alerts" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Incident Operations" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Priority support" Foreground="#E8EDF7" Margin="0,3"/>
     <Button x:Name="PlusMonthlyButton" Content="PLUS MONTHLY" Margin="0,16,0,6" Padding="12,8" Background="#7657FF" Foreground="White" Click="PlusMonthlyButton_Click"/>
     <Button x:Name="PlusAnnualButton" Content="PLUS ANNUAL" Padding="12,8" Click="PlusAnnualButton_Click"/>
    </StackPanel>
   </Border>

   <Border Grid.Column="4" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="10" Padding="16">
    <StackPanel>
     <TextBlock Text="ENTERPRISE" Foreground="#D9E1EE" FontSize="20" FontWeight="Bold"/>
     <TextBlock x:Name="EnterprisePriceText" Text="Contact sales" Foreground="#38E8D0" FontSize="24" FontWeight="Bold" Margin="0,7,0,10"/>
     <TextBlock x:Name="EnterprisePositionText" Text="Organization-wide DBA operations." Foreground="#B7C3D7" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="✓ Everything in Plus" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Multi-seat licensing foundation" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Custom integrations / onboarding workspace" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="✓ Enterprise SLA policy workspace" Foreground="#E8EDF7" Margin="0,3"/>
     <TextBlock Text="BETA · Shared team operations (local preview)" Foreground="#BDA7FF" Margin="0,8,0,3"/>
     <TextBlock Text="BETA · SSO / RBAC configuration foundation" Foreground="#BDA7FF" Margin="0,3"/>
     <TextBlock Text="BETA · Audit / central policy foundation" Foreground="#BDA7FF" Margin="0,3"/>
     <Button x:Name="EnterpriseButton" Content="CONTACT SALES" Margin="0,16,0,0" Padding="12,8" Click="EnterpriseButton_Click"/>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>

 <Border Grid.Row="3" Background="#101526" BorderBrush="#20263A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
  <TextBlock x:Name="BillingStatusText" Foreground="#B7C3D7" TextWrapping="Wrap"/>
 </Border>
</Grid>
</Window>