<Window x:Class="DBACheck2.App.IncidentOperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Incident Operations">
<Grid Background="#0B1220"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="125"/></Grid.RowDefinitions>
<StackPanel Margin="6"><TextBlock x:Name="TitleText" Text="INCIDENT OPERATIONS" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Foreground="#B7C3D7" Text="Beta 1 · Incident Center · Evidence · Safe Playbooks"/></StackPanel>
<DataGrid x:Name="GridIncidents" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridIncidents_SelectionChanged" Background="#111C2F" Foreground="White"><DataGrid.Columns>
<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn x:Name="DatabaseColumn" Header="Database" Binding="{Binding DatabaseName}" Width="160"/><DataGridTextColumn x:Name="ModuleColumn" Header="Módulo" Binding="{Binding Module}" Width="140"/><DataGridTextColumn x:Name="SeverityColumn" Header="Sev" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn x:Name="CountColumn" Header="Veces" Binding="{Binding RecurrenceCount}" Width="70"/><DataGridTextColumn x:Name="ProblemColumn" Header="Problema" Binding="{Binding Problem}" Width="*"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8"><Button x:Name="AnalyzeButton" Content="CORRELACIONAR" Width="140" Margin="0,0,8,0" Click="AnalyzeButton_Click" IsEnabled="False"/><Button x:Name="ReportButton" Content="REPORTE TÉCNICO" Width="150" Margin="0,0,8,0" Click="ReportButton_Click" IsEnabled="False"/><Button x:Name="VerifyButton" Content="REVALIDAR" Width="120" Margin="0,0,8,0" Click="VerifyButton_Click" IsEnabled="False"/><Button x:Name="JobButton" Content="PLAYBOOK: JOB" Width="150" Click="JobButton_Click" IsEnabled="False"/><Button x:Name="ExpandDetailButton" Content="EXPANDIR" Width="110" Margin="8,0,0,0" Click="ExpandDetailButton_Click"/><TextBlock x:Name="StatusText" Foreground="White" Margin="16,5"/></StackPanel>
<Border Grid.Row="3" Background="#111C2F" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailText" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap" Text="Seleccioná un incidente OPEN."/></ScrollViewer></Border>
</Grid></Window>