<Window x:Class="DBACheck2.App.TempDbAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - TempDB &amp; Version Store Analyzer" Height="720" Width="1240" MinHeight="620" MinWidth="1000" WindowStartupLocation="CenterOwner" Background="#0B1220">
<Window.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="170"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="INCIDENT ANALYZER · TEMPDB &amp; VERSION STORE" Foreground="#38E8D0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Beta 1 · Espacio · Files · Version Store · Correlación contextual · Solo lectura" Foreground="#B7C3D7"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"><Button x:Name="RefreshButton" Padding="18,8" Content="ACTUALIZAR" Click="RefreshButton_Click"/><Button x:Name="DiagnosisButton" Margin="10,0,0,0" Padding="18,8" Content="DIAGNÓSTICO" Click="DiagnosisButton_Click"/><Button x:Name="FilesButton" Margin="10,0,0,0" Padding="18,8" Content="VER FILES" Click="FilesButton_Click"/><Button x:Name="VersionButton" Margin="10,0,0,0" Padding="18,8" Content="VER VERSION STORE" Click="VersionButton_Click"/><Button x:Name="EvidenceButton" Margin="10,0,0,0" Padding="18,8" Content="CAPTURAR EVIDENCIA" Click="EvidenceButton_Click"/><TextBlock x:Name="AnalyzerStatus" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="White"/></StackPanel>
<TextBlock Grid.Row="2" x:Name="SummaryText" Margin="2,0,0,10" Foreground="#D5DEEB" FontWeight="SemiBold" Text="Consultando TempDB..."/>
<DataGrid x:Name="FilesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding FileId}" Width="50"/><DataGridTextColumn Header="Logical" Binding="{Binding LogicalName}" Width="130"/><DataGridTextColumn Header="Size MB" Binding="{Binding SizeMb}" Width="100"/><DataGridTextColumn Header="Used MB" Binding="{Binding UsedMb}" Width="100"/><DataGridTextColumn Header="Free MB" Binding="{Binding FreeMb}" Width="100"/><DataGridTextColumn Header="Used %" Binding="{Binding UsedPct}" Width="90"/><DataGridTextColumn Header="Growth" Binding="{Binding Growth}" Width="110"/><DataGridTextColumn Header="Physical path" Binding="{Binding PhysicalName}" Width="*"/></DataGrid.Columns></DataGrid>
<Grid Grid.Row="4" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="#38E8D0" FontWeight="Bold" Text="EVIDENCIA / DIAGNÓSTICO TEMPDB"/><Button x:Name="ExpandDetailButton" Grid.Column="1" Content="EXPANDIR" Padding="12,4" Click="ExpandDetailButton_Click"/></Grid>
<TextBox Grid.Row="5" x:Name="DetailText" Background="#111C2F" Foreground="White" BorderThickness="0" Padding="12" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Text="Cargando..."/>
</Grid></Window>

