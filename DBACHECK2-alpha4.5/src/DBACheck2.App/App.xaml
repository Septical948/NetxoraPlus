<Application x:Class="DBACheck2.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Startup="Application_Startup" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#090B14"/>
  <SolidColorBrush x:Key="Surface" Color="#101526"/>
  <SolidColorBrush x:Key="Surface2" Color="#151B30"/>
  <SolidColorBrush x:Key="Stroke" Color="#2B3150"/>
  <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
  <SolidColorBrush x:Key="AccentHover" Color="#9278FF"/>
  <SolidColorBrush x:Key="Mint" Color="#38E8D0"/>
  <SolidColorBrush x:Key="Text" Color="#F2F5FA"/>
  <SolidColorBrush x:Key="Muted" Color="#91A0B8"/>

  <Style TargetType="Button">
   <Setter Property="Background" Value="#20283C"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="#39425D"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2B3550"/><Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#F4F6FA"/><Setter Property="Foreground" Value="#111827"/><Setter Property="BorderBrush" Value="#65708A"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#F4F6FA"/><Setter Property="Foreground" Value="#111827"/><Setter Property="BorderBrush" Value="#65708A"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="6,3"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#0F1526"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="RowBackground" Value="#111A2D"/><Setter Property="AlternatingRowBackground" Value="#162238"/><Setter Property="BorderBrush" Value="#34405C"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#26334A"/><Setter Property="RowHeaderWidth" Value="0"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202D45"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#34455F"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#172033"/><Setter Property="Padding" Value="12,6"/></Style>
 </Application.Resources>
</Application>