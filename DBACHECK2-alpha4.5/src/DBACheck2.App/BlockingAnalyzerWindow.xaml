<Window x:Class="DBACheck2.App.BlockingAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - Blocking Incident Analyzer" Height="760" Width="1320" MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterOwner" Background="#0B1220">
 <Window.Resources>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,3"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="INCIDENT ANALYZER · BLOCKING" Foreground="#38E8D0" FontSize="25" FontWeight="Bold"/><TextBlock Text="Alpha 4 · Root blocker · Blocking chain · SQL · Locks · Evidence Snapshot · Solo lectura inicial" Foreground="#B7C3D7"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,14,0,10"><Button x:Name="RefreshButton" Content="ACTUALIZAR" Padding="18,8" Margin="0,0,10,0" Click="RefreshButton_Click"/><Button Content="VER CADENA" Padding="18,8" Margin="0,0,10,0" Click="ChainButton_Click"/><Button Content="VER SQL" Padding="18,8" Margin="0,0,10,0" Click="SqlButton_Click"/><Button Content="VER LOCKS" Padding="18,8" Margin="0,0,10,0" Click="LocksButton_Click"/><Button x:Name="EvidenceButton" Content="CAPTURAR EVIDENCIA" Padding="18,8" Margin="0,0,10,0" IsEnabled="False" Click="EvidenceButton_Click"/><TextBlock x:Name="AnalyzerStatus" Foreground="White" VerticalAlignment="Center" Margin="8,0" Text="Consultando blocking actual..."/></WrapPanel>
  <DataGrid x:Name="BlockingGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" SelectionChanged="BlockingGrid_SelectionChanged">
   <DataGrid.Columns><DataGridTextColumn Header="SPID" Binding="{Binding SessionId}" Width="65"/><DataGridTextColumn Header="Root" Binding="{Binding RootBlockerId}" Width="65"/><DataGridTextColumn Header="Blocked by" Binding="{Binding BlockingSessionId}" Width="85"/><DataGridTextColumn Header="Wait sec" Binding="{Binding WaitSeconds}" Width="75"/><DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="120"/><DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="130"/><DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="150"/><DataGridTextColumn Header="App" Binding="{Binding ProgramName}" Width="220"/><DataGridTextColumn Header="Status" Binding="{Binding SessionStatus}" Width="90"/><DataGridTextColumn Header="Wait" Binding="{Binding WaitType}" Width="130"/><DataGridTextColumn Header="Open Tran" Binding="{Binding OpenTransactions}" Width="80"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="3" Margin="0,12,0,6" Text="EVIDENCIA / ANÁLISIS DEL SPID SELECCIONADO" Foreground="#38E8D0" FontWeight="Bold"/>
  <TextBox x:Name="DetailText" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111C2F" Foreground="White" BorderThickness="0" FontFamily="Consolas" Padding="12" Text="Selecciona una fila para investigar la cadena de bloqueo."/>
  <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="#718096" Text="Alpha 4 | Identifica root blocker y víctimas | Evidence Snapshot | No ejecuta KILL en esta primera validación."/>
 </Grid>
</Window>
