<Window x:Class="DBACheck2.App.IncidentHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Incident History">
<Grid Background="#0B1220" Margin="0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
<StackPanel Margin="6,4,6,10"><TextBlock Text="INCIDENT HISTORY" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Foreground="#B7C3D7" Text="Historial local de incidentes y recurrencia."/></StackPanel>
<DataGrid x:Name="IncidentGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="IncidentGrid_SelectionChanged" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
<DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="145"/><DataGridTextColumn Header="Servidor" Binding="{Binding ServerName}" Width="150"/><DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150"/><DataGridTextColumn Header="Módulo" Binding="{Binding Module}" Width="130"/><DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Veces" Binding="{Binding RecurrenceCount}" Width="65"/><DataGridTextColumn Header="Problema" Binding="{Binding Problem}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" Background="#111C2F" Margin="0,10,0,0" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailText" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap" Text="Seleccioná un incidente."/></ScrollViewer></Border>
</Grid></Window>