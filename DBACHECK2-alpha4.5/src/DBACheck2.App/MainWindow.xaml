<Window x:Class="DBACheck2.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - SQL Server Incident Assistant" Height="760" Width="1180" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#0B1220">
<Window.Resources>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#34455F"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/></Style>
</Window.Resources>
<Grid Margin="22">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="NETXORA  |  DBACHECK 2" Foreground="#38E8D0" FontSize="28" FontWeight="Bold"/><TextBlock Text="SQL Server Assessment &amp; Incident Assistant · Alpha 4.5" Foreground="#B7C3D7" FontSize="14"/></StackPanel>
 <Border Grid.Row="1" Background="#111C2F" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ServerBox" Height="36" FontSize="15" Padding="8" VerticalContentAlignment="Center" Text="localhost"/><CheckBox x:Name="TrustCertBox" Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Foreground="White" Content="Trust server certificate" IsChecked="True"/><Button x:Name="TestButton" Grid.Column="2" Margin="6,0" Padding="16,6" Content="Probar conexión" Click="TestButton_Click"/><Button x:Name="QuickButton" Grid.Column="3" Margin="6,0,0,0" Padding="18,6" Content="QUICK CHECK" FontWeight="Bold" Click="QuickButton_Click"/><Button x:Name="IncidentButton" Grid.Column="4" Margin="8,0,0,0" Padding="16,6" Content="LONG TRANSACTIONS" FontWeight="Bold" Click="IncidentButton_Click"/><Button x:Name="BlockingButton" Grid.Column="5" Margin="8,0,0,0" Padding="16,6" Content="BLOCKING ANALYZER" FontWeight="Bold" Click="BlockingButton_Click"/><Button x:Name="TempDbButton" Grid.Column="6" Margin="8,0,0,0" Padding="16,6" Content="TEMPDB ANALYZER" FontWeight="Bold" Click="TempDbButton_Click"/><Button x:Name="LogButton" Grid.Column="7" Margin="8,0,0,0" Padding="16,6" Content="LOG ANALYZER" FontWeight="Bold" Click="LogButton_Click"/><Button x:Name="BackupJobsButton" Grid.Column="8" Margin="8,0,0,0" Padding="16,6" Content="BACKUPS / JOBS" FontWeight="Bold" Click="BackupJobsButton_Click"/><Button x:Name="AlwaysOnButton" Grid.Column="9" Margin="8,0,0,0" Padding="16,6" Content="ALWAYSON / HA" FontWeight="Bold" Click="AlwaysOnButton_Click"/><Button x:Name="PerformanceButton" Grid.Column="10" Margin="8,0,0,0" Padding="16,6" Content="PERFORMANCE" FontWeight="Bold" Click="PerformanceButton_Click"/></Grid></Border>
 <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,14" Foreground="#D5DEEB" Text="Listo. Autenticación Windows integrada; DBACHECK2 no almacena la contraseña."/>
 <DataGrid x:Name="HealthGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" BorderThickness="0" FontSize="14" SelectionChanged="HealthGrid_SelectionChanged">
  <DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="150"/><DataGridTextColumn Header="Resumen" Binding="{Binding Summary}" Width="310"/><DataGridTextColumn Header="Evidencia / detalle" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns>
 </DataGrid>
 <Border Grid.Row="4" Margin="0,12,0,0" Background="#111C2F" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="DETALLE DEL CHECK SELECCIONADO" Foreground="#38E8D0" FontWeight="Bold" Margin="0,0,0,6"/><TextBlock x:Name="DetailText" Foreground="#D5DEEB" TextWrapping="Wrap" MaxHeight="110" Text="Selecciona una fila para ver la evidencia completa."/></StackPanel></Border>
 <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="#718096" Text="DBACHECK 2.0.0-alpha.4.5 | Incidents + TempDB + Log + Backups/Jobs + AlwaysOn/HA + Performance | Solo lectura."/>
</Grid>
</Window>