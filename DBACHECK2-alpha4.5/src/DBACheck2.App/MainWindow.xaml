<Window x:Class="DBACheck2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBACHECK 2 - SQL Server Incident Assistant"
        Height="820" Width="1360" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#0B1220">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#34455F"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#16243A"/><Setter Property="Foreground" Value="#D5DEEB"/><Setter Property="BorderBrush" Value="#263A56"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#34455F"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Global connection context: always visible -->
        <Border Grid.Row="0" Background="#111C2F" BorderBrush="#22324A" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETXORA  |  DBACHECK 2" Foreground="#38E8D0" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Alpha 5.2 · Assistant + Profiles + Multi-engine" Foreground="#8291A8" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="DESTINO SQL" Foreground="#8291A8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,10,0"/>
                <TextBox x:Name="ServerBox" Grid.Column="2" Height="36" MinWidth="230" MaxWidth="520" FontSize="14" Padding="9" VerticalContentAlignment="Center" Text="localhost" HorizontalAlignment="Stretch" ToolTip="Servidor, servidor\instancia, IP o IP,puerto"/>
                <CheckBox x:Name="TrustCertBox" Grid.Column="3" Margin="14,0" VerticalAlignment="Center" Foreground="#D5DEEB" Content="Trust certificate" IsChecked="True"/>
                <Button x:Name="TestButton" Grid.Column="4" Style="{StaticResource ActionButton}" Content="PROBAR CONEXIÓN" Click="TestButton_Click"/>
                <Border Grid.Column="5" x:Name="ConnectionBadge" Background="#263244" CornerRadius="4" Padding="11,6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStateText" Text="NO VERIFICADA" Foreground="#B7C3D7" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Operational navigation; no analyzer opens a second window -->
            <Border Grid.Column="0" Background="#0E1828" BorderBrush="#22324A" BorderThickness="0,0,1,0" Padding="14,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="OPERACIÓN" Foreground="#718096" FontSize="11" FontWeight="Bold" Margin="6,0,0,10"/>
                        <Button x:Name="QuickButton" Style="{StaticResource NavButton}" Content="Quick Check" Click="QuickButton_Click"/>
                        <Button x:Name="IncidentButton" Style="{StaticResource NavButton}" Content="Long Transactions" Click="IncidentButton_Click"/>
                        <Button x:Name="BlockingButton" Style="{StaticResource NavButton}" Content="Blocking Analyzer" Click="BlockingButton_Click"/>
                        <Button x:Name="TempDbButton" Style="{StaticResource NavButton}" Content="TempDB / Version Store" Click="TempDbButton_Click"/>
                        <Button x:Name="LogButton" Style="{StaticResource NavButton}" Content="Transaction Log" Click="LogButton_Click"/>
                        <Button x:Name="BackupJobsButton" Style="{StaticResource NavButton}" Content="Backups / Jobs" Click="BackupJobsButton_Click"/>
                        <Button x:Name="AlwaysOnButton" Style="{StaticResource NavButton}" Content="AlwaysOn / HA" Click="AlwaysOnButton_Click"/>
                        <Button x:Name="PerformanceButton" Style="{StaticResource NavButton}" Content="Performance" Click="PerformanceButton_Click"/>
                        <Button x:Name="HistoryButton" Style="{StaticResource NavButton}" Content="Incident History" Click="HistoryButton_Click"/>
                        <Button x:Name="OperationsButton" Style="{StaticResource NavButton}" Content="Incident Operations" Click="OperationsButton_Click"/>
                        <Button x:Name="AssistantButton" Style="{StaticResource NavButton}" Content="DBA Assistant / Profiles" Click="AssistantButton_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock Text="CONTEXTO ACTUAL" Foreground="#718096" FontSize="10" FontWeight="Bold" Margin="6,18,0,5"/>
                        <TextBlock x:Name="TargetContextText" Text="localhost" Foreground="#D5DEEB" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBlock Text="Windows Authentication" Foreground="#718096" FontSize="11" Margin="6,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <!-- Quick Check is the home operational view -->
                <Grid x:Name="QuickCheckView">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="QUICK CHECK" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Estado operativo del SQL Server seleccionado. Solo lectura." Foreground="#B7C3D7"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="2,0,0,12" Foreground="#D5DEEB" Text="Listo. Seleccioná el destino SQL y ejecutá Quick Check."/>
                    <DataGrid x:Name="HealthGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" BorderThickness="0" FontSize="14" SelectionChanged="HealthGrid_SelectionChanged">
                        <DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="150"/><DataGridTextColumn Header="Resumen" Binding="{Binding Summary}" Width="310"/><DataGridTextColumn Header="Evidencia / detalle" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Margin="0,12,0,0" Background="#111C2F" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="EVIDENCIA DEL CHECK SELECCIONADO" Foreground="#38E8D0" FontWeight="Bold" Margin="0,0,0,6"/><TextBlock x:Name="DetailText" Foreground="#D5DEEB" TextWrapping="Wrap" MaxHeight="105" Text="Seleccioná una fila para ver la evidencia completa."/></StackPanel></Border>
                </Grid>

                <!-- Existing analyzers are hosted here instead of ShowDialog -->
                <ContentControl x:Name="ModuleHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0E1828" BorderBrush="#22324A" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock Foreground="#718096" FontSize="11" Text="DBACHECK 2.0.0-alpha.5.2 | DBA Assistant | Server Profiles | Multi-engine foundation | Read-only"/>
        </Border>
    </Grid>
</Window>