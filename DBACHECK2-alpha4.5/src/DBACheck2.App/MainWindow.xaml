<Window x:Class="DBACheck2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DBACHECK 2 - Multi-Engine DBA Assistant"
        Height="820" Width="1360" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" ResizeMode="CanResize" Background="#0A0D18"
        StateChanged="MainWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#34455F"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E8EDF7"/></Style>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9E1EE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#17172A"/><Setter Property="Foreground" Value="#BDA7FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#1C1932"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#34455F"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9E1EE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20283B"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#8F9BB3"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Padding="6,7" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="▸" Foreground="#718096" FontSize="12" Margin="8,0,2,0"/>
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111628" BorderBrush="#22324A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="64">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="18,8,12,8" VerticalAlignment="Center">
                    <TextBlock Text="NETXORA  |  DBACHECK 2" Foreground="#38E8D0" FontSize="21" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Text="Beta 1 · Plataforma DBA Multi-Engine" Foreground="#8291A8" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="LanguageLabelText" Text="IDIOMA" Foreground="#8291A8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="LanguageBox" Width="90" Height="30" SelectionChanged="LanguageBox_SelectionChanged">
                        <ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="─" ToolTip="Minimize" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" ToolTip="Maximize / Restore" Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Content="✕" ToolTip="Close" Click="CloseButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="EngineLabelText" Visibility="Collapsed"/><TextBlock x:Name="TargetLabelText" Visibility="Collapsed"/><ComboBox x:Name="GlobalEngineBox" Visibility="Collapsed" SelectionChanged="GlobalEngineBox_SelectionChanged"/><TextBox x:Name="ServerBox" Visibility="Collapsed" Text="localhost"/><CheckBox x:Name="TrustCertBox" Visibility="Collapsed" IsChecked="True"/><Button x:Name="TestButton" Visibility="Collapsed" Click="TestButton_Click"/><Border x:Name="ConnectionBadge" Visibility="Collapsed"><TextBlock x:Name="ConnectionStateText"/></Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- START stays open; the remaining sections are collapsible. -->
            <Border Grid.Column="0" Background="#0D1120" BorderBrush="#20263A" BorderThickness="0,0,1,0" Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="OperationLabelText" Text="START" Foreground="#8F9BB3" FontSize="10" FontWeight="Bold" Margin="6,0,0,7"/>
                            <Button x:Name="AssistantButton" Style="{StaticResource NavButton}" Content="Connections / Profiles" Click="AssistantButton_Click"/>
                            <Button x:Name="QuickButton" Style="{StaticResource NavButton}" Content="Quick Check" Click="QuickButton_Click"/>

                            <Expander x:Name="DiagnosticsExpander" Style="{StaticResource SectionExpander}" Header="DIAGNOSTICS" IsExpanded="False" Expanded="NavExpander_Expanded">
                                <StackPanel>
                                    <Button x:Name="IncidentButton" Style="{StaticResource NavButton}" Content="Long Transactions" Click="IncidentButton_Click"/>
                                    <Button x:Name="BlockingButton" Style="{StaticResource NavButton}" Content="Blocking Analyzer" Click="BlockingButton_Click"/>
                                    <Button x:Name="TempDbButton" Style="{StaticResource NavButton}" Content="TempDB / Version Store" Click="TempDbButton_Click"/>
                                    <Button x:Name="LogButton" Style="{StaticResource NavButton}" Content="Transaction Log" Click="LogButton_Click"/>
                                    <Button x:Name="BackupJobsButton" Style="{StaticResource NavButton}" Content="Backups / Jobs" Click="BackupJobsButton_Click"/>
                                    <Button x:Name="AlwaysOnButton" Style="{StaticResource NavButton}" Content="AlwaysOn / HA" Click="AlwaysOnButton_Click"/>
                                    <Button x:Name="PerformanceButton" Style="{StaticResource NavButton}" Content="Performance" Click="PerformanceButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="IntegrationsExpander" Style="{StaticResource SectionExpander}" Header="INTEGRATIONS" IsExpanded="False" Expanded="NavExpander_Expanded">
                                <StackPanel>
                                    <Button x:Name="IntegrationsButton" Style="{StaticResource NavButton}" Content="Monitoring Integrations" Click="IntegrationsButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="IncidentsExpander" Style="{StaticResource SectionExpander}" Header="INCIDENTS" IsExpanded="False" Expanded="NavExpander_Expanded">
                                <StackPanel>
                                    <Button x:Name="HistoryButton" Style="{StaticResource NavButton}" Content="Incident History" Click="HistoryButton_Click"/>
                                    <Button x:Name="OperationsButton" Style="{StaticResource NavButton}" Content="Incident Operations" Click="OperationsButton_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="CurrentContextLabelText" Text="CONTEXTO ACTUAL" Foreground="#718096" FontSize="10" FontWeight="Bold" Margin="6,12,0,5"/>
                        <TextBlock x:Name="TargetContextText" Text="localhost" Foreground="#D5DEEB" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBlock x:Name="AuthenticationText" Text="Windows Authentication" Foreground="#718096" FontSize="11" Margin="6,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <!-- Quick Check is the home operational view -->
                <Grid x:Name="QuickCheckView">
                    <Grid.Resources><Style x:Key="InsightCard" TargetType="Border"><Setter Property="Background" Value="#121427"/><Setter Property="BorderBrush" Value="#302B4E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,10,0"/></Style></Grid.Resources>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="QuickTitleText" Text="QUICK CHECK" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="QuickSubtitleText" Text="Estado operativo del destino seleccionado. Solo lectura." Foreground="#B7C3D7"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="2,0,0,12" Foreground="#D5DEEB" Text="Listo. Seleccioná el destino / perfil y ejecutá Quick Check."/>
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource InsightCard}"><StackPanel><TextBlock x:Name="InsightHealthLabel" Text="HEALTH" Foreground="#8F9BB3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InsightHealthValue" Text="—" Foreground="#38E8D0" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource InsightCard}"><StackPanel><TextBlock x:Name="InsightAlertLabel" Text="ALERTS" Foreground="#8F9BB3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InsightAlertValue" Text="—" Foreground="#F0B45A" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource InsightCard}"><StackPanel><TextBlock x:Name="InsightTopLabel" Text="TOP FINDING" Foreground="#8F9BB3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InsightTopValue" Text="—" Foreground="#E8EDF7" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource InsightCard}" Margin="0"><StackPanel><TextBlock x:Name="InsightEngineLabel" Text="ENGINE" Foreground="#8F9BB3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InsightEngineValue" Text="—" Foreground="#BDA7FF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <DataGrid x:Name="HealthGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" BorderThickness="0" FontSize="14" SelectionChanged="HealthGrid_SelectionChanged">
                        <DataGrid.Columns><DataGridTextColumn x:Name="StatusColumn" Header="Estado" Binding="{Binding Status}" Width="100"/><DataGridTextColumn x:Name="AreaColumn" Header="Área" Binding="{Binding Area}" Width="150"/><DataGridTextColumn x:Name="SummaryColumn" Header="Resumen" Binding="{Binding Summary}" Width="310"/><DataGridTextColumn x:Name="EvidenceColumn" Header="Evidencia / detalle" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="4" Margin="0,12,0,0" Background="#111C2F" CornerRadius="6" Padding="12">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="EvidenceTitleText" Text="EVIDENCIA DEL CHECK SELECCIONADO" Foreground="#38E8D0" FontWeight="Bold" VerticalAlignment="Center"/>
   <Button x:Name="EvidenceExpandButton" Grid.Column="1" Content="EXPANDIR" Padding="12,4" Click="EvidenceExpandButton_Click"/>
  </Grid>
  <TextBox x:Name="DetailText" Grid.Row="1" Margin="0,8,0,0" Foreground="#D5DEEB" Background="Transparent" BorderThickness="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="120" Text="Seleccioná una fila para ver la evidencia completa."/>
 </Grid>
</Border>
                </Grid>

                <!-- Existing analyzers are hosted here instead of ShowDialog -->
                <ContentControl x:Name="ModuleHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0E1828" BorderBrush="#22324A" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock x:Name="FooterText" Foreground="#718096" FontSize="11" Text="DBACHECK 2 Beta 1 | Multi-engine | Read-only"/>
        </Border>
    </Grid>
</Window>