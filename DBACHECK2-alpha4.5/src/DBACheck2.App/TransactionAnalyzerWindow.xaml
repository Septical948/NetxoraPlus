<Window x:Class="DBACheck2.App.TransactionAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DBACHECK 2 - Long Transaction Incident Analyzer" Height="820" Width="1380" MinHeight="720" MinWidth="1150" WindowStartupLocation="CenterOwner" Background="#0B1220">
 <Window.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="0"/></Style></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="125"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="INCIDENT ANALYZER · LONG TRANSACTIONS" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/><TextBlock Text="Beta 1 · Diagnosis Engine · SQL · Locks · Transacción · Evidence Snapshot · KILL protegido" Foreground="#B7C3D7"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,14,0,10"><Button x:Name="RefreshButton" Content="ACTUALIZAR" Padding="16,7" Click="RefreshButton_Click"/><Button x:Name="DiagnosticButton" Content="DIAGNÓSTICO" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="DiagnosticButton_Click"/><Button x:Name="SqlButton" Content="VER SQL" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="SqlButton_Click"/><Button x:Name="LocksButton" Content="VER LOCKS" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="LocksButton_Click"/><Button x:Name="TransactionButton" Content="VER TRANSACCIÓN" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="TransactionButton_Click"/><Button x:Name="EvidenceButton" Content="CAPTURAR EVIDENCIA" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="EvidenceButton_Click"/><Button x:Name="StatusOnlyButton" Content="ROLLBACK STATUS" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="StatusOnlyButton_Click"/><Button x:Name="KillButton" Content="KILL PROTEGIDO" Padding="16,7" Margin="8,0,0,0" IsEnabled="False" Click="KillButton_Click"/><TextBlock x:Name="AnalyzerStatus" Foreground="#D5DEEB" Margin="14,8,0,0" Text="Cargando transacciones &gt;= 30 min..."/></WrapPanel>
  <DataGrid x:Name="TransactionGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A" SelectionChanged="TransactionGrid_SelectionChanged"><DataGrid.Columns>
   <DataGridTextColumn Header="SPID" Binding="{Binding SessionId}" Width="65"/><DataGridTextColumn Header="Min" Binding="{Binding Minutes}" Width="70"/><DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="145"/><DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="145"/><DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="145"/><DataGridTextColumn Header="App" Binding="{Binding ProgramName}" Width="190"/><DataGridTextColumn Header="Status" Binding="{Binding SessionStatus}" Width="90"/><DataGridTextColumn Header="Open Tran" Binding="{Binding OpenTransactions}" Width="85"/><DataGridTextColumn Header="Blocked by" Binding="{Binding BlockingSessionId}" Width="85"/><DataGridTextColumn Header="Wait" Binding="{Binding WaitType}" Width="*"/>
  </DataGrid.Columns></DataGrid>
  <Grid Grid.Row="3" Margin="0,14,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EVIDENCIA / DIAGNÓSTICO DEL SPID SELECCIONADO" Foreground="#38E8D0" FontWeight="Bold"/><Button x:Name="ExpandDetailButton" Grid.Column="1" Content="EXPANDIR" Padding="12,4" Click="ExpandDetailButton_Click"/></Grid>
  <TextBox x:Name="EvidenceText" Grid.Row="4" Background="#111C2F" Foreground="#D5DEEB" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Selecciona una transacción para investigar."/>
  <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="#718096" Text="Beta 1 ·| Diagnosis Engine | Version Store es contexto GLOBAL | KILL requiere evidencia + revalidación + confirmación explícita."/>
 </Grid>
</Window>
