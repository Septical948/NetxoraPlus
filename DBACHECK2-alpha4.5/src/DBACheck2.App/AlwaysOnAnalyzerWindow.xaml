<Window x:Class="DBACheck2.App.AlwaysOnAnalyzerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - AlwaysOn / HA Incident Analyzer" Height="760" Width="1320" MinHeight="650" MinWidth="1050"
 WindowStartupLocation="CenterOwner" Background="#0B1220">
<Window.Resources>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22324A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,3"/></Style>
</Window.Resources>
<Grid Margin="16">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailRow" Height="125"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="TitleText" Text="INCIDENT ANALYZER · ALWAYSON / HA" Foreground="#38E8D0" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="Beta 1 · Availability Groups · Replicas · Databases · Queues · Listener · Evidence · Read-only" Foreground="#B7C3D7"/></StackPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
  <Button x:Name="RefreshButton" Padding="18,8" Content="ACTUALIZAR" Click="RefreshButton_Click"/>
  <Button x:Name="DiagnosticButton" Margin="10,0,0,0" Padding="18,8" Content="DIAGNÓSTICO" Click="DiagnosticButton_Click" IsEnabled="False"/>
  <Button x:Name="ReplicaButton" Margin="10,0,0,0" Padding="18,8" Content="VER RÉPLICA" Click="ReplicaButton_Click" IsEnabled="False"/>
  <Button x:Name="DatabaseButton" Margin="10,0,0,0" Padding="18,8" Content="VER DATABASE" Click="DatabaseButton_Click" IsEnabled="False"/>
  <Button x:Name="ListenerButton" Margin="10,0,0,0" Padding="18,8" Content="VER LISTENER" Click="ListenerButton_Click"/>
  <Button x:Name="EvidenceButton" Margin="10,0,0,0" Padding="18,8" Content="CAPTURAR EVIDENCIA" Click="EvidenceButton_Click" IsEnabled="False"/>
  <TextBlock x:Name="AnalyzerStatus" Margin="18,0,0,0" Foreground="White" VerticalAlignment="Center" Text="Consultando AlwaysOn..."/>
 </StackPanel>
 <TextBlock Grid.Row="2" x:Name="SummaryText" Margin="2,0,0,8" Foreground="#D5DEEB" FontWeight="SemiBold"/>
 <DataGrid x:Name="AgGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="AgGrid_SelectionChanged"
   Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
  <DataGrid.Columns>
   <DataGridTextColumn x:Name="StatusColumn" Header="Estado" Binding="{Binding Status}" Width="85"/>
   <DataGridTextColumn Header="AG" Binding="{Binding AvailabilityGroup}" Width="130"/>
   <DataGridTextColumn Header="Replica" Binding="{Binding ReplicaServer}" Width="155"/>
   <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
   <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="145"/>
   <DataGridTextColumn Header="Sync state" Binding="{Binding SynchronizationState}" Width="130"/>
   <DataGridTextColumn Header="Health" Binding="{Binding SynchronizationHealth}" Width="105"/>
   <DataGridCheckBoxColumn Header="Suspended" Binding="{Binding IsSuspended}" Width="80"/>
   <DataGridTextColumn Header="Send Q KB" Binding="{Binding LogSendQueueKb}" Width="90"/>
   <DataGridTextColumn Header="Redo Q KB" Binding="{Binding RedoQueueKb}" Width="90"/>
   <DataGridTextColumn Header="Send KB/s" Binding="{Binding LogSendRateKb}" Width="90"/>
   <DataGridTextColumn Header="Redo KB/s" Binding="{Binding RedoRateKb}" Width="90"/>
  </DataGrid.Columns>
 </DataGrid>
 <Grid Grid.Row="4" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="#38E8D0" FontWeight="Bold" Text="EVIDENCIA / DIAGNÓSTICO ALWAYSON"/><Button x:Name="ExpandDetailButton" Grid.Column="1" Content="EXPANDIR" Padding="12,4" Click="ExpandDetailButton_Click"/></Grid>
 <TextBox Grid.Row="5" x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111C2F" Foreground="White" BorderThickness="0" Padding="12" FontFamily="Consolas" Text="Selecciona una réplica/base para investigar."/>
</Grid>
</Window>