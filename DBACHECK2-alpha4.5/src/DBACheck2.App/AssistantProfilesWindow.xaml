<Window x:Class="DBACheck2.App.AssistantProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Server Profiles">
<Grid Background="#090B14">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Margin="8,8,8,14" Padding="18" Background="#121427" BorderBrush="#342B59" BorderThickness="1" CornerRadius="10">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="TitleText" Text="SERVER PROFILES" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="Beta 1 · Multi-engine · Read-only" Foreground="#AAB5C8" Margin="0,3,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#211B3D" BorderBrush="#744CFF" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="READ-ONLY" Foreground="#BDA7FF" FontSize="10" FontWeight="Bold"/></Border>
  </Grid>
 </Border>

 <Border Grid.Row="1" Margin="8,0,8,12" Padding="16" Background="#101526" BorderBrush="#2B3150" BorderThickness="1" CornerRadius="10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="SAVED PROFILE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><ComboBox x:Name="ProfilesBox" MinWidth="520" DisplayMemberPath="Display" SelectionChanged="ProfilesBox_SelectionChanged"/></StackPanel>
    <Button x:Name="LoadButton" Grid.Column="1" Content="CARGAR" Margin="10,17,0,0" MinWidth="105" Click="Load_Click"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="PROFILE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="ProfileName" Text="SQL-PROD" ToolTip="Nombre del perfil"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="ENGINE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><ComboBox x:Name="EngineBox"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="HOST / IP" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="HostBox" Text="localhost"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="PORT" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><Grid><TextBox x:Name="PortBox"/><TextBlock x:Name="PortHint" Text="Port" Foreground="#687386" Margin="8,0" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid></StackPanel>
    <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="DATABASE / SERVICE" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><Grid><TextBox x:Name="DatabaseBox"/><TextBlock x:Name="DatabaseHint" Text="Database / Service" Foreground="#687386" Margin="8,0" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid></StackPanel>
    <StackPanel Grid.Column="5" Margin="0,0,8,0"><TextBlock Text="USERNAME" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><Grid><TextBox x:Name="UsernameBox"/><TextBlock x:Name="UsernameHint" Text="Username" Foreground="#687386" Margin="8,0" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid></StackPanel>
    <StackPanel Grid.Column="6"><TextBlock Text="PASSWORD · SESSION ONLY" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/><Grid><PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/><TextBlock x:Name="PasswordHint" Text="Password" Foreground="#687386" Margin="8,0" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid></StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Credentials are used only for the current session. Saved profiles never store the password." Foreground="#718096" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SaveButton" Content="GUARDAR" MinWidth="105" Margin="0,0,8,0" Click="Save_Click"/><Button x:Name="TestProfileButton" Content="PROBAR" MinWidth="105" Margin="0,0,8,0" Click="Test_Click"/><Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" Content="CONECTAR" MinWidth="125" Click="UseProfile_Click"/></StackPanel>
   </Grid>
  </Grid>
 </Border>

 <TextBlock Grid.Row="2" Text="CONNECTION STATUS" Foreground="#91A0B8" FontSize="10" FontWeight="Bold" Margin="14,0,0,7"/>
 <Border Grid.Row="3" Margin="8,0,8,8" Background="#101526" BorderBrush="#2B3150" BorderThickness="1" CornerRadius="10" Padding="16">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="OutputText" Foreground="#F2F5FA" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Text="Seleccioná o guardá un perfil."/></ScrollViewer>
 </Border>
</Grid></Window>