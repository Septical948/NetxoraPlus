<Window x:Class="DBACheck2.App.AssistantProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Server Profiles">
<Grid Background="#0A0D18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Margin="8" Padding="16" Background="#121427" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock x:Name="TitleText" Text="SERVER PROFILES" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="Beta 1 · Multi-engine · Read-only" Foreground="#B7C3D7"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="115"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
<TextBox x:Name="ProfileName" Text="SQL-PROD" Margin="2" ToolTip="Nombre del perfil"/>
<ComboBox x:Name="EngineBox" Grid.Column="1" Margin="2"/>
<TextBox x:Name="HostBox" Grid.Column="2" Text="localhost" Margin="2" ToolTip="Host / IP"/>
<Grid Grid.Column="3" Margin="2"><TextBox x:Name="PortBox"/><TextBlock x:Name="PortHint" Text="Port" Foreground="#888" Margin="5,2" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
<Grid Grid.Column="4" Margin="2"><TextBox x:Name="DatabaseBox"/><TextBlock x:Name="DatabaseHint" Text="Database / Service" Foreground="#888" Margin="5,2" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
<Grid Grid.Column="5" Margin="2"><TextBox x:Name="UsernameBox"/><TextBlock x:Name="UsernameHint" Text="Username" Foreground="#888" Margin="5,2" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
<Grid Grid.Column="6" Margin="2"><PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/><TextBlock x:Name="PasswordHint" Text="Password" Foreground="#888" Margin="5,2" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid><Button x:Name="SaveButton" Grid.Column="7" Content="GUARDAR" Margin="2" Click="Save_Click"/><Button x:Name="LoadButton" Grid.Column="8" Content="CARGAR" Margin="2" Click="Load_Click"/><Button x:Name="UseButton" Grid.Column="9" Content="USAR PERFIL" Margin="2" Click="UseProfile_Click"/></Grid>
<Grid Grid.Row="2" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><ComboBox x:Name="ProfilesBox" Width="520" DisplayMemberPath="Display" SelectionChanged="ProfilesBox_SelectionChanged"/><Button x:Name="TestProfileButton" Content="PROBAR" Width="100" Margin="8,0" Click="Test_Click"/></DockPanel><Border Grid.Row="1" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0"><ScrollViewer><TextBlock x:Name="OutputText" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap" Text="Seleccioná o guardá un perfil."/></ScrollViewer></Border></Grid>
</Grid></Window>