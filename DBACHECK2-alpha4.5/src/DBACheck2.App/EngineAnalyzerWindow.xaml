<Window x:Class="DBACheck2.App.EngineAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Multi-engine analyzer">
<Grid Background="#0B1220" Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="TitleText" Foreground="#38E8D0" FontSize="24" FontWeight="Bold" Margin="10"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10"><Button Content="ACTUALIZAR" Padding="18,7" Click="Refresh_Click"/><TextBlock x:Name="ContextText" Foreground="#B7C3D7" Margin="14,8"/></StackPanel>
<DataGrid x:Name="GridData" Grid.Row="2" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" Background="#111C2F" Foreground="White" SelectionChanged="GridData_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="170"/><DataGridTextColumn Header="Resumen" Binding="{Binding Summary}" Width="330"/><DataGridTextColumn Header="Evidencia" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="DetailText" Grid.Row="3" Margin="10" Padding="10" Background="#111C2F" Foreground="#D5DEEB" TextWrapping="Wrap" Text="Seleccioná una fila para ver evidencia."/></Grid></Window>
