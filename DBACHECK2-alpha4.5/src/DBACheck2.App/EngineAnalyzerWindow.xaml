<Window x:Class="DBACheck2.App.EngineAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Multi-engine analyzer">
<Grid Background="#0A0D18" Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="TitleText" Foreground="#38E8D0" FontSize="24" FontWeight="Bold" Margin="10"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10"><Button x:Name="RefreshButton" Content="ACTUALIZAR" Padding="18,7" Background="#241C45" Foreground="White" BorderBrush="#744CFF" Click="Refresh_Click"/><TextBlock x:Name="ContextText" Foreground="#B7C3D7" Margin="14,8"/></StackPanel>
<DataGrid x:Name="GridData" Grid.Row="2" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F1526" Foreground="#F2F5FA" RowBackground="#111A2D" AlternatingRowBackground="#162238" SelectionChanged="GridData_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Resumen" Binding="{Binding Summary}" Width="330"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Evidencia" Binding="{Binding Detail}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D8E0EE"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
<TextBlock x:Name="DetailText" Grid.Row="3" Margin="10" Padding="10" Background="#111628" Foreground="#E8EDF7" TextWrapping="Wrap" Text="Seleccioná una fila para ver evidencia."/></Grid></Window>
