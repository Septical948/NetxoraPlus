<Window x:Class="DBACheck2.App.EnterpriseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DBACHECK 2 - Enterprise Center" Background="#0A0D18">
<Grid Margin="14">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,10">
  <TextBlock x:Name="TitleText" Text="ENTERPRISE CENTER" Foreground="#38E8D0" FontSize="24" FontWeight="Bold"/>
  <TextBlock x:Name="SubtitleText" Text="Organization, team operations, access, policies and governance" Foreground="#B7C3D7"/>
 </StackPanel>

 <Border Grid.Row="1" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="WorkspaceStatusText" Foreground="#D9E1EE" FontWeight="Bold"/>
    <TextBlock x:Name="BackendStatusText" Foreground="#8F9BB3" Margin="0,3,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" x:Name="RefreshAllButton" Content="REFRESH" Padding="14,7" Click="RefreshAllButton_Click"/>
  </Grid>
 </Border>

 <TabControl Grid.Row="2" Background="#0A0D18" BorderThickness="0">
  <TabItem x:Name="OrganizationTab" Header="ORGANIZATION">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,10,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="ORGANIZATION NAME" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="OrganizationNameBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="DOMAIN" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="DomainBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="SEAT LIMIT" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="SeatLimitBox" Height="32" Margin="0,4,0,12"/>
      <Button x:Name="SaveOrganizationButton" Content="SAVE ORGANIZATION" Padding="14,8" Click="SaveOrganizationButton_Click"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#111628" BorderBrush="#302B4E" BorderThickness="1" CornerRadius="8" Padding="16">
      <StackPanel>
       <TextBlock x:Name="SeatSummaryTitle" Text="LICENSING / SEATS" Foreground="#38E8D0" FontSize="16" FontWeight="Bold"/>
       <TextBlock x:Name="SeatSummaryText" Foreground="#E8EDF7" Margin="0,10,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="Enterprise licensing is represented locally in Beta 2. Production seat validation will come from the Enterprise licensing API." Foreground="#8F9BB3" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Grid>
   </ScrollViewer>
  </TabItem>

  <TabItem x:Name="MembersTab" Header="MEMBERS">
   <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="MemberEmailBox" Height="32" Margin="0,0,8,0" ToolTip="Email"/>
     <TextBox Grid.Column="1" x:Name="MemberNameBox" Height="32" Margin="0,0,8,0" ToolTip="Display name"/>
     <ComboBox Grid.Column="2" x:Name="MemberRoleBox" Height="32" Margin="0,0,8,0"/>
     <Button Grid.Column="3" x:Name="AddMemberButton" Content="ADD MEMBER" Padding="14,7" Click="AddMemberButton_Click"/>
    </Grid>
    <DataGrid x:Name="MembersGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
      <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*"/>
      <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1*"/>
      <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1*"/>
      <DataGridCheckBoxColumn Header="Seat" Binding="{Binding SeatAssigned}" Width="60"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </TabItem>

  <TabItem x:Name="OperationsTab" Header="SHARED OPERATIONS">
   <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="160"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="OperationPriorityBox" Height="32" Margin="0,0,8,0"/>
     <TextBox Grid.Column="1" x:Name="OperationHostBox" Height="32" Margin="0,0,8,0" ToolTip="Host"/>
     <TextBox Grid.Column="2" x:Name="OperationEngineBox" Height="32" Margin="0,0,8,0" ToolTip="Engine"/>
     <TextBox Grid.Column="3" x:Name="OperationSummaryBox" Height="32" Margin="0,0,8,0" ToolTip="Summary"/>
     <TextBox Grid.Column="4" x:Name="OperationOwnerBox" Height="32" Margin="0,0,8,0" ToolTip="Owner"/>
     <Button Grid.Column="5" x:Name="AddOperationButton" Content="ADD" Padding="14,7" Click="AddOperationButton_Click"/>
    </Grid>
    <DataGrid x:Name="OperationsGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
      <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="150"/>
      <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="110"/>
      <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
      <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="140"/>
      <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
      <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="160"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </TabItem>

  <TabItem x:Name="AccessTab" Header="SSO / RBAC / POLICIES">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,10,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="SSO MODE" Foreground="#8F9BB3" FontWeight="Bold"/>
      <ComboBox x:Name="SsoModeBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="ISSUER / METADATA URL" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="SsoIssuerBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="CLIENT ID / APP ID" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="SsoClientIdBox" Height="32" Margin="0,4,0,10"/>
      <TextBlock Text="DEFAULT ROLE" Foreground="#8F9BB3" FontWeight="Bold"/>
      <ComboBox x:Name="DefaultRoleBox" Height="32" Margin="0,4,0,10"/>
      <CheckBox x:Name="RequireSsoBox" Content="Require SSO" Foreground="#E8EDF7" Margin="0,4"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="CENTRAL POLICIES" Foreground="#38E8D0" FontWeight="Bold" FontSize="16"/>
      <CheckBox x:Name="ReadOnlyDefaultBox" Content="Read-only by default" Foreground="#E8EDF7" Margin="0,12,0,4"/>
      <CheckBox x:Name="ProtectedConfirmBox" Content="Require confirmation for protected actions" Foreground="#E8EDF7" Margin="0,4"/>
      <CheckBox x:Name="RequireIncidentBox" Content="Require incident before protected action" Foreground="#E8EDF7" Margin="0,4"/>
      <CheckBox x:Name="SharedOperationsBox" Content="Enable shared operations" Foreground="#E8EDF7" Margin="0,4,0,10"/>
      <TextBlock Text="AUDIT RETENTION DAYS" Foreground="#8F9BB3" FontWeight="Bold"/>
      <TextBox x:Name="AuditRetentionBox" Height="32" Margin="0,4,0,12"/>
      <Button x:Name="SaveAccessButton" Content="SAVE ACCESS / POLICIES" Padding="14,8" Click="SaveAccessButton_Click"/>
      <TextBlock x:Name="SsoNoticeText" Foreground="#8F9BB3" TextWrapping="Wrap" Margin="0,12,0,0"
       Text="Beta 2 stores Enterprise access policy configuration locally. Production SSO enforcement and central RBAC require the Enterprise backend."/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </TabItem>

  <TabItem x:Name="OnboardingTab" Header="ONBOARDING / SLA">
   <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="CUSTOM INTEGRATION REQUEST" Foreground="#38E8D0" FontWeight="Bold"/>
      <TextBox x:Name="IntegrationNameBox" Height="32" Margin="0,8,0,6" ToolTip="Name"/>
      <TextBox x:Name="IntegrationTypeBox" Height="32" Margin="0,0,0,6" ToolTip="Type"/>
      <TextBox x:Name="IntegrationEndpointBox" Height="32" Margin="0,0,0,6" ToolTip="Product / endpoint"/>
      <TextBox x:Name="IntegrationNotesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="Notes"/>
      <Button x:Name="AddIntegrationRequestButton" Content="ADD REQUEST" Padding="14,7" Click="AddIntegrationRequestButton_Click"/>
     </StackPanel>
     <DataGrid x:Name="IntegrationRequestsGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1*"/>
       <DataGridTextColumn Header="Type" Binding="{Binding IntegrationType}" Width="1*"/>
       <DataGridTextColumn Header="Product / Endpoint" Binding="{Binding EndpointOrProduct}" Width="2*"/>
       <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>

    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="ENTERPRISE SLA" Foreground="#38E8D0" FontWeight="Bold"/>
     <DataGrid x:Name="SlaGrid" Grid.Row="1" Margin="0,8,0,8" AutoGenerateColumns="False" CanUserAddRows="False"
      Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" IsReadOnly="True" Width="80"/>
       <DataGridTextColumn Header="Response min" Binding="{Binding ResponseTargetMinutes}" Width="110"/>
       <DataGridTextColumn Header="Resolution min" Binding="{Binding ResolutionTargetMinutes}" Width="120"/>
       <DataGridTextColumn Header="Escalation" Binding="{Binding EscalationContact}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <Button Grid.Row="2" x:Name="SaveSlaButton" Content="SAVE SLA" Padding="14,7" HorizontalAlignment="Right" Click="SaveSlaButton_Click"/>
    </Grid>
   </Grid>
  </TabItem>

  <TabItem x:Name="AuditTab" Header="AUDIT">
   <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="RefreshAuditButton" Content="REFRESH AUDIT" Padding="14,7" HorizontalAlignment="Left" Click="RefreshAuditButton_Click"/>
    <DataGrid x:Name="AuditGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      Background="#111C2F" Foreground="White" RowBackground="#111C2F" AlternatingRowBackground="#16243A">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="160"/>
      <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="130"/>
      <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="190"/>
      <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="170"/>
      <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </TabItem>
 </TabControl>
</Grid>
</Window>