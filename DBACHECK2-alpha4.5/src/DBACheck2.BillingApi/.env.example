# NEVER commit real Stripe secrets.
# Prefer a restricted key (rk_test_ / rk_live_) when the required permissions are sufficient.
STRIPE_SECRET_KEY=rk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

STRIPE_PRICE_STANDARD_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_STANDARD_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_PLUS_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PLUS_ANNUAL=price_REPLACE_ME

# Public HTTPS origin of the Billing API in production.
# For local checkout testing localhost is fine; webhook testing uses Stripe CLI forwarding.
DBACHECK2_PUBLIC_URL=http://localhost:5098

# Optional. Defaults to ./data/billing.db
DBACHECK2_BILLING_DB=

# Desktop application points to this API.
# Configure on the Windows workstation, not on the server process:
# DBACHECK2_BILLING_API=http://localhost:5098


# Desktop entitlement grace after a paid-through date while a subscription is PastDue.
# Configure on the Windows client when entitlement enforcement is enabled.
# DBACHECK2_BILLING_GRACE_DAYS=2
